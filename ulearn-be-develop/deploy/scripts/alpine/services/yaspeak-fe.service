[Unit]
Description=FrontEnd of yaspeak.com

[Service]
WorkingDirectory=/var/www/fe
ExecStart=npm run start
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=yaspeak-fe
User=root
Environment=NEXT_PUBLIC_BE_API_URL=https://int.beapi.yaspeak.com/
Environment=NEXT_PUBLIC_WEBSOCKET_API_ENDPOINT=https://int.beapi.yaspeak.com/

[Install]
WantedBy=multi-user.target