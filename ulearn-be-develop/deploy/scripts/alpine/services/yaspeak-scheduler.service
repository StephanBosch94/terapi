[Unit]
Description=Scheduler of yaspeak.com

[Service]
WorkingDirectory=/var/www/scheduler
ExecStart=/home/yaspeak_admin/.dotnet/dotnet /var/www/scheduler/Yaspeak.Be.Scheduler.dll --environment Int
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=yaspeak-scheduler
User=root
Environment=ASPNETCORE_ENVIRONMENT=Int
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target