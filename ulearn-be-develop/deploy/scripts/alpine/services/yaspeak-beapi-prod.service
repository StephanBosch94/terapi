#sudo nano /etc/systemd/system/yaspeak-beapi-prod.service
[Unit]
Description=Prod BE.API service of Yaspeak.com

[Service]
WorkingDirectory=/var/www/beapi-prod
ExecStart=dotnet /var/www/beapi-prod/ULearn.Be.Api.dll --urls=http://0.0.0.0:6000
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=yaspeak-beapi-prod
User=root
Environment=ASPNETCORE_ENVIRONMENT=Prod
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target