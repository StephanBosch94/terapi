#sudo nano /etc/systemd/system/yaspeak-fs-prod.service
[Unit]
Description=FileService Prod of Yaspeak.com

[Service]
WorkingDirectory=/var/www/fs-prod
ExecStart=dotnet /var/www/fs/ULearn.Be.File.Api.dll --urls=http://0.0.0.0:6100
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=yaspeak-fs-prod
User=root
Environment=ASPNETCORE_ENVIRONMENT=Prod
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target