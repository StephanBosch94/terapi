[Unit]
Description=Scheduler of yaspeak.com

[Service]
WorkingDirectory=/var/www/scheduler-prod
ExecStart=dotnet /var/www/scheduler-prod/Yaspeak.Be.Scheduler.dll --environment Prod
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=yaspeak-scheduler-prod
User=root
Environment=ASPNETCORE_ENVIRONMENT=Prod
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target